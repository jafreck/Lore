+  const deadline = Date.now() + timeoutMs;
+  while (Date.now() < deadline) {
+    try {
+      if (condition()) return;
+    } catch {
+      // Ignore transient state while async CLI work is still running.
+    }
+    await new Promise<void>((r) => setTimeout(r, 20));
